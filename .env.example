# ═══════════════════════════════════════════════════════════
# OmniSMS Backend — v4.0 — Variables d'environnement
# ═══════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplissez les valeurs.
# Sur Render : Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
BACKEND_URL=https://omnisms-backend.onrender.com

# ── CORS (origines autorisées, séparées par virgule) ────────
CORS_ORIGIN=https://omnisms.netlify.app,https://omnisms.web.app

# ── JWT ─────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici
API_KEY=votre_api_key_optionnel

# ── Firebase Admin SDK ───────────────────────────────────────
# Contenu JSON du fichier serviceAccountKey.json (sur une seule ligne)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Admin ────────────────────────────────────────────────────
ADMIN_KEY=votre_admin_key_secrete
# UIDs Firebase des administrateurs (séparés par virgule)
ADMIN_UIDS=firebase_uid_admin1,firebase_uid_admin2

# ── Redis (BullMQ + Cache) ───────────────────────────────────
# Render → Add-ons → Redis (plan gratuit disponible)
# Format : redis://[:password@]host[:port][/db-number]
# Sans Redis : fallback mémoire automatique (non persisté, non distribué)
REDIS_URL=redis://default:password@host.render.com:6379

# ── GeniusPay (Paiements) ────────────────────────────────────
GENIUSPAY_PUBLIC_KEY=votre_public_key_geniuspay
GENIUSPAY_SECRET_KEY=votre_secret_key_geniuspay
GENIUSPAY_WEBHOOK_SECRET=votre_webhook_secret_geniuspay

# ── Infobip SMS ──────────────────────────────────────────────
INFOBIP_API_KEY=votre_api_key_infobip
INFOBIP_BASE_URL=votre_subdomain.api.infobip.com
INFOBIP_SENDER_ID=OmniSMS

# ── Transcription Audio (Faster-Whisper) ─────────────────────
# URL du service Python Faster-Whisper
# Si déployé séparément sur Render (service Python)
WHISPER_SERVICE_URL=http://localhost:9000
# Modèle : tiny (39MB), base (74MB), small (244MB), medium (769MB)
WHISPER_MODEL=small
# Langue par défaut
WHISPER_LANGUAGE=fr
# Device : cpu (Render gratuit) ou cuda (GPU)
WHISPER_DEVICE=cpu

# ── Socket.IO (Temps Réel) ───────────────────────────────────
# Aucune config requise — Socket.IO utilise le même port que Express.
# Client Flutter/JS : io('https://omnisms-backend.onrender.com', { auth: { token: 'JWT_TOKEN' } })

# ── Téléphonie ───────────────────────────────────────────────
# Code pays par défaut pour normalisation numéros
# BF=Burkina Faso, SN=Sénégal, CI=Côte d'Ivoire, ML=Mali, etc.
DEFAULT_PHONE_COUNTRY=BF
