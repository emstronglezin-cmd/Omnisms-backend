# ============================================================
# OmniSMS Backend — Configuration
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne jamais committer le fichier .env dans Git.
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=changer_ce_secret_jwt_tres_long_et_aleatoire
API_KEY=votre_cle_api_interne

# ── URL publique du backend ───────────────────────────────────
# Utilisée pour construire les return_url et webhook_url
BACKEND_URL=https://votre-backend.onrender.com

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Admin (routes /admin/*) ───────────────────────────────────
ADMIN_KEY=votre_cle_admin_secrete

# ============================================================
# FIREBASE — OBLIGATOIRE
# ============================================================
# Contenu JSON du Service Account Firebase (sur une seule ligne).
# Obtenir depuis : console.firebase.google.com
#   → Paramètres du projet → Comptes de service → Générer une clé privée
#
# Sur Render : Settings → Environment → ajouter FIREBASE_SERVICE_ACCOUNT_JSON
# En local   : mettre la valeur dans .env (entre guillemets simples si JSON multi-ligne)
#
# Format attendu : {"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"VOTRE_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@VOTRE_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ============================================================
# SYSTÈME 1 — GENIUSPAY (PRIMAIRE — SYSTÈME PRINCIPAL)
# ============================================================
# 1. Connectez-vous sur https://pay.genius.ci
# 2. Créez un compte Marchand et récupérez vos clés API
# 3. Configurez l'URL webhook dans le dashboard GeniusPay :
#    https://omnisms-backend.onrender.com/api/payment/webhook
#
# Clé publique GeniusPay → header X-API-Key :
GENIUSPAY_PUBLIC_KEY=pk_live_VOTRE_CLE_PUBLIQUE_GENIUSPAY
#
# Alias acceptés (compatibilité) :
# GENIUSPAY_API_KEY=pk_live_VOTRE_CLE_PUBLIQUE_GENIUSPAY
#
# Clé secrète GeniusPay → header X-API-Secret (JAMAIS côté client !) :
GENIUSPAY_SECRET_KEY=sk_live_VOTRE_CLE_SECRETE_GENIUSPAY
#
# Alias accepté :
# GENIUSPAY_API_SECRET=sk_live_VOTRE_CLE_SECRETE_GENIUSPAY
#
# Secret HMAC pour valider les webhooks (optionnel mais recommandé) :
GENIUSPAY_WEBHOOK_SECRET=

# ── Routes GeniusPay disponibles ──────────────────────────────
#   POST /api/payment/geniuspay         → créer un paiement (retourne checkout_url)
#   POST /api/payment/webhook           → webhook GeniusPay (signature HMAC)
#   GET  /api/user/status?userId=XXX    → { "premium": true/false }
#   GET  /api/payment/link?userId=XXX   → lien de paiement (Notion/Flutter)
#
# Routes avancées :
#   POST /api/payment/geniuspay/create
#   POST /api/payment/geniuspay/webhook
#   GET  /api/payment/geniuspay/status/:id
#   GET  /api/payment/geniuspay/config

# ============================================================
# SYSTÈME 2 — FUSION PAY API (CONSERVÉ — PARALLÈLE)
# ============================================================
FUSION_PAY_API_URL=https://api.moneyfusion.net/VotreApp/VotreCle/pay/
FUSION_PAY_API_KEY=votre_cle_api_privee_fusionpay
FUSION_PAY_APP_ID=OmniSMS
# Optionnel : secret HMAC pour valider les webhooks Fusion Pay
FUSION_PAY_WEBHOOK_SECRET=

# ============================================================
# SMS PROVIDERS (optionnels)
# ============================================================

# Africa's Talking
AFRICASTALKING_API_KEY=votre_api_key
AFRICASTALKING_USERNAME=votre_username

# Twilio
TWILIO_ACCOUNT_SID=votre_account_sid
TWILIO_AUTH_TOKEN=votre_auth_token
TWILIO_PHONE=+votre_numero_twilio
# Alias accepté (les deux fonctionnent)
TWILIO_PHONE_NUMBER=+votre_numero_twilio

# Orange
ORANGE_CLIENT_ID=votre_client_id
ORANGE_CLIENT_SECRET=votre_client_secret
ORANGE_SENDER_ID=+22675405214
