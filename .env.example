# ============================================================
# OmniSMS Backend v3.0 — Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# On Render: Settings → Environment Variables
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
BACKEND_URL=https://omnisms-backend.onrender.com
CORS_ORIGIN=*

# ── Admin ────────────────────────────────────────────────────
ADMIN_KEY=your_admin_secret_key

# ── JWT (REQUIRED) ───────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
API_KEY=your_internal_api_key

# ============================================================
# FIREBASE (REQUIRED — auth + Firestore)
# ============================================================
# Get from: console.firebase.google.com
#   → Project Settings → Service accounts → Generate new private key
#
# Paste the entire JSON on ONE line:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ============================================================
# GENIUSPAY — Payment provider (REQUIRED for payments)
# ============================================================
# 1. Sign in at https://pay.genius.ci
# 2. Create a Merchant account and get your API keys
# 3. Set webhook URL in GeniusPay dashboard:
#    https://omnisms-backend.onrender.com/api/payment/webhook
#    https://omnisms-backend.onrender.com/api/payment/geniuspay/webhook
#
# Public key (X-API-Key header):
GENIUSPAY_PUBLIC_KEY=pk_live_YOUR_GENIUSPAY_PUBLIC_KEY
# Secret key (X-API-Secret header — NEVER expose client-side):
GENIUSPAY_SECRET_KEY=sk_live_YOUR_GENIUSPAY_SECRET_KEY
# HMAC secret for webhook signature verification (recommended):
GENIUSPAY_WEBHOOK_SECRET=

# ── GeniusPay endpoints ───────────────────────────────────────
#   POST /api/payment/geniuspay          → initiate payment (returns checkout_url)
#   POST /api/payment/webhook            → GeniusPay webhook (HMAC verified)
#   POST /api/payment/geniuspay/create   → initiate (detailed response)
#   POST /api/payment/geniuspay/webhook  → webhook alias
#   GET  /api/payment/geniuspay/status/:id → payment status
#   GET  /api/payment/geniuspay/config   → Flutter config
#   GET  /api/payment/link?userId=XXX    → direct payment link
#   GET  /api/user/status?userId=XXX     → { premium: true/false }

# ============================================================
# INFOBIP — SMS provider (REQUIRED for SMS)
# ============================================================
# 1. Create account at https://portal.infobip.com
# 2. Settings → API Keys → Create new key
# 3. Copy your personal Base URL shown in the portal
# 4. Set webhook in: Channels → SMS → Configuration → Default webhook URL
#    → https://omnisms-backend.onrender.com/webhooks/infobip
#
# API key:
INFOBIP_API_KEY=your_infobip_api_key
# Account-specific base URL (do NOT use the generic api.infobip.com):
INFOBIP_BASE_URL=https://XXXXXX.api.infobip.com
# Sender ID shown on recipient's phone (max 15 chars):
INFOBIP_SENDER_ID=OmniSMS

# ── Infobip endpoints ─────────────────────────────────────────
#   POST /api/sms/send           → outbound SMS (JWT auth required)
#   POST /webhooks/infobip       → inbound SMS + delivery reports
#   GET  /api/sms/infobip/status → configuration status
