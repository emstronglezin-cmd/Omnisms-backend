# ═══════════════════════════════════════════════════════════
# OmniSMS Backend — v4.1 — Variables d'environnement
# ═══════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplissez les valeurs.
# Sur Render : Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
BACKEND_URL=https://omnisms-backend.onrender.com

# ── Frontend ─────────────────────────────────────────────────
# URL du frontend (redirection après paiement)
FRONTEND_URL=https://omnisms.netlify.app

# ── CORS (origines autorisées, séparées par virgule) ────────
CORS_ORIGIN=https://omnisms.netlify.app,https://omnisms.web.app

# ── JWT ─────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici
API_KEY=votre_api_key_optionnel

# ── Firebase Admin SDK ───────────────────────────────────────
# Contenu JSON du fichier serviceAccountKey.json (sur une seule ligne)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Admin ────────────────────────────────────────────────────
ADMIN_KEY=votre_admin_key_secrete
# UIDs Firebase des administrateurs (séparés par virgule)
ADMIN_UIDS=firebase_uid_admin1,firebase_uid_admin2

# ── Redis (BullMQ + Cache) ───────────────────────────────────
# Render → Add-ons → Redis (plan gratuit disponible)
# Format : redis://[:password@]host[:port][/db-number]
# Sans Redis : fallback mémoire automatique (non persisté, non distribué)
REDIS_URL=redis://default:password@host.render.com:6379

# ── LeekPay (Paiements — Mobile Money & Carte) ──────────────
# Créez un compte sur https://www.leekpay.me/register
# Dashboard → Clés API → Nouvelle clé API
#
# Clé publique (pk_live_xxx) — utilisée pour la signature webhook
LEEKPAY_API_KEY=pk_live_votre_cle_publique_ici

# Clé secrète (sk_live_xxx) — authentification API serveur UNIQUEMENT
LEEKPAY_SECRET_KEY=sk_live_votre_cle_secrete_ici

# URL de base LeekPay (ne pas modifier sauf en sandbox)
LEEKPAY_BASE_URL=https://leekpay.fr

# Secret webhook optionnel (si défini, remplace LEEKPAY_API_KEY pour la signature)
# Si absent, LEEKPAY_API_KEY est utilisée pour vérifier la signature webhook
LEEKPAY_WEBHOOK_SECRET=

# Montant premium OmniSMS (défaut 2000 XOF)
LEEKPAY_PREMIUM_AMOUNT=2000
LEEKPAY_PREMIUM_CURRENCY=XOF

# URL webhook à configurer dans LeekPay Dashboard → Clés API :
# https://omnisms-backend.onrender.com/api/payment/webhook/leekpay

# ── INfiniReach (Transport Offline PRINCIPAL — Z Fold2) ─────────────────────
#
# Fournisseur : INfiniReach (https://api.infinireach.io)
# Le Z Fold2 est enregistré et connecté dans l'application Android INfiniReach.
#
# Architecture :
#   OmniSMS Backend → INfiniReach API → Z Fold2 → SIM → réseau SMS
#   SMS → SIM → Z Fold2 → INfiniReach → webhook → OmniSMS Backend
#
# API d'envoi :
#   POST https://api.infinireach.io/api/v1/messages
#   Headers : X-API-Key: ${INFINIREACH_API_KEY}
#   Body    : { "to": "+226...", "message": "...", "from": "${INFINIREACH_FROM_NUMBER}",
#              "channel": "sms", "externalId": "omnisms-xxx" }
#
# Webhook entrant à configurer dans l'app INfiniReach :
#   URL   : https://omnisms-backend.onrender.com/api/webhooks/sms-gateway/inbound
#   Event : message.inbound
#   (Optionnel) Events supplémentaires : message.delivered, message.failed
#
# Où trouver les valeurs :
#   INFINIREACH_API_KEY     → Dashboard INfiniReach → API Keys
#   INFINIREACH_FROM_NUMBER → Numéro SIM du Z Fold2 (format E.164, ex: +22600000000)

# Clé API INfiniReach (OBLIGATOIRE)
INFINIREACH_API_KEY=votre_cle_api_infinireach

# Numéro SIM du Z Fold2 — champ "from" obligatoire dans l'API INfiniReach (OBLIGATOIRE)
INFINIREACH_FROM_NUMBER=+226xxxxxxxx

# URL de base de l'API INfiniReach (ne pas modifier sauf en test)
INFINIREACH_API_URL=https://api.infinireach.io

# Activer/désactiver le transport INfiniReach (défaut: true)
INFINIREACH_ENABLED=true

# Secret de signature webhook (vide = mode permissif pour le premier test)
# Configurer après validation initiale pour sécuriser les webhooks entrants
INFINIREACH_WEBHOOK_SECRET=

# Validation de signature stricte (rejette les webhooks non signés)
# Activer APRÈS avoir configuré INFINIREACH_WEBHOOK_SECRET
INFINIREACH_REQUIRE_SIGNATURE=false

# ── Sélection du transport Offline ───────────────────────────
# sms_gateway = INfiniReach Z Fold2 (DÉFAUT, transport principal)
# infobip     = Infobip cloud (standby, utilisé si INfiniReach non configuré)
OFFLINE_SMS_PROVIDER=sms_gateway

# Fallback automatique sur Infobip si INfiniReach échoue (défaut: false)
OFFLINE_SMS_FALLBACK_TO_INFOBIP=false

# ── Infobip SMS (Transport Offline EN STANDBY) ───────────────
# Conservé et non supprimé. Activable via OFFLINE_SMS_PROVIDER=infobip
# ou via OFFLINE_SMS_FALLBACK_TO_INFOBIP=true (fallback si INfiniReach échoue)
INFOBIP_API_KEY=votre_api_key_infobip
INFOBIP_BASE_URL=votre_subdomain.api.infobip.com
INFOBIP_SENDER_ID=OmniSMS

# ── Transcription Audio (Faster-Whisper) ─────────────────────
# ── Transcription Audio (Faster-Whisper / Groq) ─────────────
#
# OPTION 1 — RECOMMANDÉE : Groq Whisper API (GRATUIT, ultra-rapide)
# Créez une clé sur https://console.groq.com → API Keys
# Quota gratuit : 28 800 secondes audio / mois
# Modèles : whisper-large-v3-turbo (rapide) | whisper-large-v3 (précis)
GROQ_API_KEY=gsk_votre_cle_groq_ici
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OPTION 2 — Faster-Whisper service Python séparé (optionnel)
# Si vous déployez le service Python whisper_service/ sur Render comme service séparé
WHISPER_SERVICE_URL=http://localhost:9000

# Paramètres communs
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr
WHISPER_DEVICE=cpu

# ── Socket.IO (Temps Réel) ───────────────────────────────────
# Aucune config requise — Socket.IO utilise le même port que Express.
# Client Flutter/JS : io('https://omnisms-backend.onrender.com', { auth: { token: 'JWT_TOKEN' } })

# ── Téléphonie ───────────────────────────────────────────────
# Code pays par défaut pour normalisation numéros
# BF=Burkina Faso, SN=Sénégal, CI=Côte d'Ivoire, ML=Mali, etc.
DEFAULT_PHONE_COUNTRY=BF
