{
  "name": "omnisms-backend",
  "version": "2.2.0",
  "description": "OmniSMS Backend — Production-ready Node.js Express API with Firebase + Fusion Pay",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required'",
    "lint": "node --check server.js && find . -name '*.js' -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/functions/*' -not -path '*/parse/*' | xargs -I{} node --check {}",
    "audit:check": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "africastalking": "^0.7.4",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.2",
    "firebase-admin": "^10.3.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "author": "",
  "license": "ISC"
}
